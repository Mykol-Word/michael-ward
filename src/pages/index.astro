---
import '../styles/global.css';
import projectsData from '../data/projects.json';
import experienceData from '../data/experience.json';

const colorClasses = {
	blue: "border-blue-500",
	purple: "border-purple-500",
	green: "border-green-500",
	orange: "border-orange-500",
	pink: "border-pink-500",
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/images/coin.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Michael Ward</title>
		<script is:inline define:vars={{ basePath: import.meta.env.BASE_URL }}>
			window.BASE_URL = basePath;
		</script>
		<script is:inline>
			(async function() {
				const exts = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'avif'];
				const base = (window.BASE_URL || '').replace(/\/$/, '');
				for (const ext of exts) {
					const url = `${base}/images/background.${ext}`;
					const found = await new Promise(res => {
						const img = new Image();
						img.onload = () => res(true);
						img.onerror = () => res(false);
						img.src = url;
					});
					if (found) {
						document.body.style.backgroundImage = `url('${url}')`;
						break;
					}
				}
			})();
		</script>
	</head>
	<body class="min-h-screen relative" style="background-size: cover; background-position: center; background-attachment: fixed;">
		<div id="bg-tint" style="position: fixed; inset: 0; z-index: 0; pointer-events: none; background: rgba(30, 110, 200, 0.38); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"></div>
		<div id="score-display" class="fixed top-4 right-4 z-50 retro-score">
			Coins: <span id="score">0</span>
		</div>

		<div id="shop-display" class="fixed top-24 right-4 z-50 retro-shop">
			<div class="shop-item" id="purple-item">
				<button id="purple-btn" class="shop-button" data-cost="15" title="Purple is my favorite color!">
					<span class="shop-name">Purple BG</span>
					<span class="shop-cost">15 Coins</span>
				</button>
				<button id="purple-toggle" class="toggle-button" style="display: none;" title="Toggle purple background">Toggle</button>
			</div>
			<div class="shop-item" id="evil-item">
				<button id="evil-btn" class="shop-button" data-cost="40" title="Turn the site evil - inverted colors, dark theme">
					<span class="shop-name">Evil Mode</span>
					<span class="shop-cost">40 Coins</span>
				</button>
				<button id="evil-toggle" class="toggle-button" style="display: none;" title="Toggle evil mode">Toggle</button>
			</div>
			<div class="shop-item" id="newcoin-item">
				<button id="newcoin-btn" class="shop-button" data-cost="50" title="Replace coin with a new image">
					<span class="shop-name">New Coin</span>
					<span class="shop-cost">50 Coins</span>
				</button>
				<button id="newcoin-toggle" class="toggle-button" style="display: none;" title="Toggle new coin">Toggle</button>
			</div>
		</div>

		<div class="responsive-container mx-auto px-4 sm:px-6 py-6 sm:py-12 relative z-10">
			<!-- Profile Section -->
			<div class="retro-panel mb-8">
				<div class="retro-title-bar">
					<span class="retro-title-text">Profile</span>
				</div>
				<div class="retro-content">
					<div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
						<!-- Profile Picture -->
						<div class="flex-shrink-0">
							<div class="retro-avatar">
								<div class="retro-avatar-inner">
									<img src={`${import.meta.env.BASE_URL}/images/headshot.jpg`} alt="Profile photo" />
								</div>
							</div>
						</div>

						<!-- Name and Description -->
						<div class="flex-1 w-full">
							<h1 class="retro-wordart mb-4">Michael Ward</h1>
							<div class="space-y-2">
								<div class="retro-stat-box">
									<span class="retro-label">School:</span>
									<span class="retro-value">UCLA - B.S. Computer Science & Engineering and Philosophy</span>
								</div>
								<div class="retro-stat-box">
									<span class="retro-label">Contact:</span>
									<a href="https://en.wikipedia.org/wiki/Trollface" target="_blank" class="retro-link">michaelward1916@ucla.edu</a>
								</div>
								<div class="retro-stat-box">
									<span class="retro-label">GitHub:</span>
									<a href="https://github.com/Mykol-Word" target="_blank" class="retro-link">https://github.com/Mykol-Word</a>
								</div>
								<div class="retro-stat-box">
									<span class="retro-label">Last Updated:</span>
									<span class="retro-value">April 2026</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- About Section -->
			<div class="retro-panel mb-8">
				<div class="retro-title-bar">
					<span class="retro-title-text">About</span>
				</div>
				<div class="retro-content">
					<div class="retro-quest-item">
						<p class="retro-quest-text">
							I'm a third year undergraduate at UCLA studying Computer Science & Engineering and Philosophy. I focus on embedded systems, robotics, machine learning, and hardware-software integration. In philosophy, my main interest is moral philosophy. <br><br>

							My non-academic interests are weight-lifting, climbing, game development/modding, and playing video games. I'm pretty bad at all but the last of these.
						</p>
					</div>
				</div>
			</div>

			<!-- Experience Section -->
			<div class="retro-panel mb-8">
				<div class="retro-title-bar">
					<span class="retro-title-text">Experience</span>
				</div>
				<div class="retro-content">
					<div class="space-y-4">
						{experienceData.map((experience, index) => (
							<div class="retro-quest-item">
								<div class="flex justify-between items-start mb-2">
									<div>
										<div class="flex items-center gap-3 flex-wrap">
											<h3 class="retro-quest-title">{experience.title}</h3>
											{experience.links && experience.links.length > 0 && (
												<div class="flex gap-2">
													{experience.links.map((link) => (
														<a href={link.url} target="_blank" class="retro-link text-sm">[{link.label}]</a>
													))}
												</div>
											)}
										</div>
										<p class="retro-employer-text">{experience.employer}</p>
									</div>
									<span class="retro-date-badge">{experience.date}</span>
								</div>
								<p class="retro-quest-text">
									{experience.description}
								</p>
							</div>
						))}
					</div>
				</div>
			</div>

			<!-- Projects Section -->
			<div class="retro-panel">
				<div class="retro-title-bar">
					<span class="retro-title-text">Cool Projects</span>
				</div>
				<div class="retro-content">
					{projectsData.map((categoryGroup, groupIndex) => (
						<div class={groupIndex > 0 ? "mt-6" : ""}>
							<div class="retro-category-box">
								<div class="retro-category-header collapsible-header expanded" data-category={categoryGroup.category}>
									<span class="category-chevron">▶</span>
									{categoryGroup.category}
								</div>
								<div class="category-content expanded">
									<div class="space-y-4">
										{categoryGroup.projects.map((project) => (
											<div class="retro-quest-item">
												<div class="flex justify-between items-start mb-2">
													<div class="flex items-center gap-3 flex-wrap">
														<h3 class="retro-quest-title">{project.title}</h3>
														{project.links && project.links.length > 0 && (
															<div class="flex gap-2">
																{project.links.map((link) => (
																	<a href={link.url} target="_blank" class="retro-link text-sm">[{link.label}]</a>
																))}
															</div>
														)}
													</div>
													<span class="retro-date-badge">{project.date}</span>
												</div>
												<p class="retro-quest-text">
													{project.description}
												</p>
											</div>
										))}
									</div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>

		<style>
			/* ============================================
			   FRUTIGER AERO - True Glassmorphism Styles
			   ============================================ */

			* { font-family: 'Segoe UI', Trebuchet MS, Arial, sans-serif; }

			/* Shared glass mixin values via layered box-shadow + backdrop */
			.retro-panel {
				background: rgba(255, 255, 255, 0.14);
				backdrop-filter: blur(22px) saturate(180%);
				-webkit-backdrop-filter: blur(22px) saturate(180%);
				border: 1px solid rgba(255, 255, 255, 0.55);
				border-bottom-color: rgba(255, 255, 255, 0.2);
				border-right-color: rgba(255, 255, 255, 0.2);
				border-radius: 16px;
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.6) inset,        /* top gloss edge */
					0 -1px 0 rgba(0, 0, 0, 0.08) inset,            /* bottom inner shadow */
					0 12px 40px rgba(10, 60, 160, 0.2),             /* outer glow */
					0 2px 8px rgba(0, 0, 0, 0.08);
			}

			/* Title bar */
			.retro-title-bar {
				background: linear-gradient(180deg,
					rgba(180, 230, 255, 0.75) 0%,
					rgba(70, 160, 245, 0.65) 48%,
					rgba(30, 110, 210, 0.72) 49%,
					rgba(20, 90, 190, 0.68) 100%);
				backdrop-filter: blur(12px) saturate(160%);
				-webkit-backdrop-filter: blur(12px) saturate(160%);
				border: none;
				border-bottom: 1px solid rgba(10, 60, 160, 0.25);
				border-radius: 15px 15px 0 0;
				padding: 8px 16px;
				margin: 0;
				position: relative;
				overflow: hidden;
			}

			/* Gloss sheen — top half bright, bottom half subtle */
			.retro-title-bar::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 52%;
				background: linear-gradient(180deg,
					rgba(255, 255, 255, 0.65) 0%,
					rgba(255, 255, 255, 0.18) 100%);
				border-radius: 15px 15px 0 0;
				pointer-events: none;
			}

			.retro-title-text {
				font-size: 1.5rem;
				font-weight: 700;
				color: #fff;
				text-shadow:
					0 1px 0 rgba(255, 255, 255, 0.4),
					0 2px 6px rgba(0, 60, 160, 0.7),
					0 0 20px rgba(80, 180, 255, 0.5);
				letter-spacing: 0.5px;
				position: relative;
				z-index: 1;
			}

			.retro-content {
				padding: 20px;
			}

			/* Profile Avatar */
			.retro-avatar {
				width: 140px;
				height: 140px;
				border-radius: 14px;
				border: 1px solid rgba(255, 255, 255, 0.7);
				border-bottom-color: rgba(255, 255, 255, 0.2);
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.7) inset,
					0 10px 30px rgba(10, 60, 180, 0.28),
					0 2px 6px rgba(0, 0, 0, 0.1);
				overflow: hidden;
			}

			.retro-avatar-inner {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: linear-gradient(135deg, #64b5f6 0%, #42a5f5 50%, #1e88e5 100%);
				font-size: 3rem;
				font-weight: 900;
				color: white;
				overflow: hidden;
			}

			.retro-avatar-inner img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
			}

			/* Name */
			.retro-wordart {
				font-size: 2.5rem;
				font-weight: 800;
				color: #ffffff;
				text-shadow:
					0 1px 0 rgba(255, 255, 255, 0.5),
					0 2px 8px rgba(0, 80, 180, 0.5),
					0 0 24px rgba(120, 200, 255, 0.4);
				letter-spacing: 1px;
			}

			/* Stat Boxes */
			.retro-stat-box {
				background: rgba(255, 255, 255, 0.2);
				backdrop-filter: blur(14px) saturate(160%);
				-webkit-backdrop-filter: blur(14px) saturate(160%);
				border: 1px solid rgba(255, 255, 255, 0.55);
				border-bottom-color: rgba(255, 255, 255, 0.15);
				border-radius: 9px;
				padding: 8px 12px;
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.6) inset,
					0 2px 8px rgba(10, 60, 180, 0.1);
			}

			.retro-label {
				font-weight: 700;
				color: #0d47a1;
			}

			.retro-value {
				color: #0d2e52;
			}

			.retro-link {
				color: #0277bd;
				text-decoration: underline;
				transition: color 0.2s;
			}

			.retro-link:hover {
				color: #0056a8;
			}

			/* Cards */
			.retro-quest-item {
				background: rgba(255, 255, 255, 0.55);
				backdrop-filter: blur(18px) saturate(170%);
				-webkit-backdrop-filter: blur(18px) saturate(170%);
				border: 1px solid rgba(255, 255, 255, 0.55);
				border-bottom-color: rgba(255, 255, 255, 0.15);
				border-radius: 12px;
				padding: 12px 16px;
				position: relative;
				overflow: hidden;
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.65) inset,
					0 6px 20px rgba(10, 60, 180, 0.14),
					0 1px 4px rgba(0, 0, 0, 0.07);
				transition: transform 0.2s, box-shadow 0.2s;
			}

			/* Gloss on cards */
			.retro-quest-item::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 42%;
				background: linear-gradient(180deg,
					rgba(255, 255, 255, 0.35) 0%,
					rgba(255, 255, 255, 0.0) 100%);
				border-radius: 12px 12px 0 0;
				pointer-events: none;
			}

			.retro-quest-item:hover {
				transform: translateY(-2px);
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.65) inset,
					0 12px 32px rgba(10, 60, 180, 0.22),
					0 2px 6px rgba(0, 0, 0, 0.1);
			}

			.retro-quest-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: #0d47a1;
			}

			/* Date badge — glassy pill with gloss */
			.retro-date-badge {
				background: linear-gradient(180deg,
					rgba(160, 215, 255, 0.82) 0%,
					rgba(50, 140, 230, 0.78) 49%,
					rgba(25, 100, 205, 0.80) 50%,
					rgba(15, 80, 185, 0.76) 100%);
				backdrop-filter: blur(10px) saturate(150%);
				-webkit-backdrop-filter: blur(10px) saturate(150%);
				color: white;
				padding: 5px 14px;
				border-radius: 20px;
				border: 1px solid rgba(255, 255, 255, 0.55);
				font-weight: 600;
				text-shadow: 0 1px 3px rgba(0, 40, 130, 0.6);
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.5) inset,
					0 3px 12px rgba(10, 60, 180, 0.28);
				position: relative;
				overflow: hidden;
			}

			.retro-date-badge::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 50%;
				background: linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0.0) 100%);
				border-radius: 20px 20px 0 0;
				pointer-events: none;
			}

			.retro-quest-text {
				color: #0d2e52;
				line-height: 1.6;
			}

			.retro-employer-text {
				font-size: 0.875rem;
				font-weight: 600;
				color: #1565c0;
				margin-top: 0.25rem;
			}

			/* Category box */
			.retro-category-box {
				background: rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(20px) saturate(160%);
				-webkit-backdrop-filter: blur(20px) saturate(160%);
				border: 1px solid rgba(255, 255, 255, 0.45);
				border-radius: 13px;
				padding: 16px;
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.5) inset,
					0 4px 16px rgba(10, 60, 180, 0.12);
			}

			/* Category header — same gloss split as title bar */
			.retro-category-header {
				background: linear-gradient(180deg,
					rgba(160, 220, 255, 0.72) 0%,
					rgba(60, 155, 240, 0.62) 48%,
					rgba(25, 105, 215, 0.68) 49%,
					rgba(15, 85, 195, 0.65) 100%);
				backdrop-filter: blur(12px) saturate(150%);
				-webkit-backdrop-filter: blur(12px) saturate(150%);
				border: none;
				border-radius: 11px 11px 0 0;
				padding: 8px 16px;
				margin: -16px -16px 16px -16px;
				font-size: 1.25rem;
				font-weight: 700;
				color: #fff;
				text-shadow: 0 1px 4px rgba(0, 50, 150, 0.65), 0 0 16px rgba(80, 180, 255, 0.4);
				position: relative;
				overflow: hidden;
				box-shadow: 0 2px 8px rgba(10, 60, 180, 0.18);
			}

			.retro-category-header::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 52%;
				background: linear-gradient(180deg,
					rgba(255, 255, 255, 0.62) 0%,
					rgba(255, 255, 255, 0.14) 100%);
				pointer-events: none;
			}

			.collapsible-header {
				cursor: pointer;
				user-select: none;
				transition: background 0.2s;
				margin: -16px -16px 0 -16px !important;
				border-radius: 11px !important;
			}

			.collapsible-header.expanded {
				margin: -16px -16px 16px -16px !important;
				border-radius: 11px 11px 0 0 !important;
			}

			.collapsible-header:hover {
				background: linear-gradient(180deg,
					rgba(180, 230, 255, 0.78) 0%,
					rgba(75, 165, 250, 0.68) 48%,
					rgba(35, 120, 220, 0.74) 49%,
					rgba(20, 100, 200, 0.70) 100%);
			}

			.collapsible-header:active {
				background: linear-gradient(180deg, rgba(50, 130, 230, 0.88) 0%, rgba(20, 90, 200, 0.85) 100%);
			}

			.category-chevron {
				display: inline-block;
				margin-right: 8px;
				transition: transform 0.3s ease;
				font-size: 0.9rem;
				position: relative;
				z-index: 1;
			}

			.collapsible-header.expanded .category-chevron {
				transform: rotate(90deg);
			}

			.category-content {
				overflow: hidden;
				transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
				max-height: 0;
				opacity: 0;
			}

			.category-content.expanded {
				max-height: 5000px;
				opacity: 1;
				margin-top: 16px;
			}

			/* Minigame UI */
			.retro-score {
				background: rgba(255, 255, 255, 0.18);
				backdrop-filter: blur(20px) saturate(180%);
				-webkit-backdrop-filter: blur(20px) saturate(180%);
				border: 1px solid rgba(255, 255, 255, 0.6);
				border-bottom-color: rgba(255, 255, 255, 0.2);
				border-radius: 13px;
				padding: 12px 20px;
				font-size: 1.25rem;
				font-weight: 700;
				color: #0d47a1;
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.7) inset,
					0 6px 20px rgba(10, 60, 180, 0.2);
			}

			.retro-shop {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.shop-item {
				display: flex;
				gap: 4px;
			}

			.shop-button {
				background: rgba(255, 255, 255, 0.18);
				backdrop-filter: blur(16px) saturate(160%);
				-webkit-backdrop-filter: blur(16px) saturate(160%);
				border: 1px solid rgba(255, 255, 255, 0.6);
				border-bottom-color: rgba(255, 255, 255, 0.2);
				border-radius: 11px;
				padding: 8px 12px;
				font-size: 0.9rem;
				font-weight: 700;
				color: #0d47a1;
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.7) inset,
					0 4px 12px rgba(10, 60, 180, 0.16);
				cursor: pointer;
				transition: all 0.15s;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 4px;
			}

			.shop-button:hover {
				background: rgba(255, 255, 255, 0.35);
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.8) inset,
					0 6px 18px rgba(10, 60, 180, 0.22);
			}

			.shop-button:active {
				transform: translateY(1px);
				box-shadow: 0 1px 4px rgba(10, 60, 180, 0.15);
			}

			.shop-button:disabled {
				opacity: 0.4;
				cursor: not-allowed;
			}

			.shop-button.purchased {
				background: rgba(100, 220, 130, 0.22);
				border-color: rgba(120, 230, 140, 0.6);
				color: #1b5e20;
			}

			.shop-name {
				font-size: 0.85rem;
			}

			.shop-cost {
				font-size: 0.75rem;
				color: #1565c0;
			}

			/* Toggle button — glassy blue pill */
			.toggle-button {
				background: linear-gradient(180deg,
					rgba(130, 200, 255, 0.72) 0%,
					rgba(40, 120, 230, 0.65) 48%,
					rgba(20, 95, 210, 0.70) 49%,
					rgba(10, 75, 190, 0.67) 100%);
				backdrop-filter: blur(12px) saturate(150%);
				-webkit-backdrop-filter: blur(12px) saturate(150%);
				border: 1px solid rgba(255, 255, 255, 0.55);
				border-bottom-color: rgba(255, 255, 255, 0.15);
				border-radius: 11px;
				padding: 8px 12px;
				font-size: 0.8rem;
				font-weight: 700;
				color: white;
				text-shadow: 0 1px 3px rgba(0, 40, 140, 0.6);
				box-shadow:
					0 2px 0 rgba(255, 255, 255, 0.45) inset,
					0 4px 10px rgba(10, 60, 180, 0.22);
				cursor: pointer;
				transition: all 0.12s;
			}

			.toggle-button:hover {
				background: linear-gradient(180deg,
					rgba(160, 220, 255, 0.80) 0%,
					rgba(60, 145, 245, 0.72) 48%,
					rgba(35, 115, 225, 0.78) 49%,
					rgba(20, 95, 205, 0.74) 100%);
			}

			.toggle-button:active {
				transform: translateY(1px);
				box-shadow: 0 1px 3px rgba(10, 60, 180, 0.2);
			}

			.toggle-button.active {
				background: linear-gradient(180deg,
					rgba(130, 235, 155, 0.80) 0%,
					rgba(40, 180, 90, 0.72) 48%,
					rgba(20, 155, 70, 0.76) 49%,
					rgba(10, 130, 55, 0.72) 100%);
				border-color: rgba(160, 255, 170, 0.55);
			}

			.game-coin {
				width: 30px;
				height: 30px;
				cursor: pointer;
			}

			.game-coin:hover {
				transform: scale(1.2);
			}

			@keyframes fadeOut {
				0% {
					opacity: 1;
					transform: scale(1);
				}
				100% {
					opacity: 0;
					transform: scale(0.3);
				}
			}

			@keyframes coinAppear {
				0% {
					opacity: 0;
					transform: scale(0);
				}
				50% {
					opacity: 0.9;
					transform: scale(1.2);
				}
				100% {
					opacity: 0.65;
					transform: scale(1);
				}
			}

			@keyframes float {
				0%, 100% {
					transform: translateY(0px);
				}
				50% {
					transform: translateY(-20px);
				}
			}

			@keyframes spin {
				0% {
					transform: rotateY(0deg);
				}
				100% {
					transform: rotateY(360deg);
				}
			}

			@keyframes collect {
				0% {
					transform: scale(1);
					opacity: 1;
				}
				100% {
					transform: scale(2) translateY(-50px);
					opacity: 0;
				}
			}

			/* Container Scaling */
			.responsive-container {
				max-width: 896px; /* Default for 1920x1080 */
			}

			/* High Resolution Display Styles - 4K (3840x2160) */
			@media (min-width: 3840px) {
				.responsive-container {
					max-width: 1792px; /* 2x for 4K */
				}

				.retro-title-text {
					font-size: 3rem; /* 2x of 1.5rem */
				}

				.retro-wordart {
					font-size: 5rem; /* 2x of 2.5rem */
				}

				.retro-avatar {
					width: 280px; /* 2x of 140px */
					height: 280px;
				}

				.retro-avatar-inner {
					font-size: 6rem; /* 2x of 3rem */
				}

				.retro-quest-title {
					font-size: 2.5rem; /* 2x of 1.25rem */
				}

				.retro-date-badge {
					font-size: 1.6rem;
					padding: 12px 24px; /* 2x */
				}

				.retro-score {
					font-size: 2.5rem; /* 2x of 1.25rem */
					padding: 24px 40px; /* 2x of 12px 20px */
					top: 2rem;
					right: 2rem;
				}

				.retro-content {
					padding: 40px; /* 2x of 20px */
				}

				.retro-stat-box {
					padding: 16px 24px; /* 2x of 8px 12px */
				}

				.retro-label, .retro-value, .retro-link {
					font-size: 2rem; /* 2x */
