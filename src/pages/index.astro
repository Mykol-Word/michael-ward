					font-size: 2.5rem; /* 2x of 1.25rem */
					padding: 16px 32px; /* 2x of 8px 16px */
				}

				.retro-employer-text {
					font-size: 1.75rem; /* 2x of 0.875rem */
					margin-top: 0.5rem; /* 2x of 0.25rem */
				}

				.retro-quest-item {
					padding: 24px 32px; /* 2x of 12px 16px */
				}

				.retro-panel {
					border-width: 8px; /* 2x of 4px */
